{
  "name": "llmassistant-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Browser e2e for SwarmUI-LLMAssistant: Playwright against a throwaway SwarmUI and a scripted mock LLM. Dev-only.",
  "type": "module",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=firefox-smoke --project=webkit-smoke",
    "test:live": "playwright test --config=live/playwright.config.ts",
    "stack": "node harness/stack.mjs",
    "install-browsers": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1"
  }
}
