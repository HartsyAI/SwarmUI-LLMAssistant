<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>SwarmExtensionLLMAssistant</AssemblyName>
    <!-- false = published HartsyInference NuGet; true = local HartsyInference engine build (see Directory.Build.props). -->
    <UseLocalHartsy Condition="'$(UseLocalHartsy)' == ''">false</UseLocalHartsy>
    <HartsyRepo Condition="'$(HartsyRepo)' == ''">$(MSBuildThisFileDirectory)../../../../HartsyInference</HartsyRepo>
    <!-- Force the alpha.4 ref (just pinned below, ahead of its publish) to resolve as soon as it's live,
         bypassing NuGet's ~30 min flat-container HTTP cache (same reasoning as the sibling extensions). -->
    <RestoreNoHttpCache>true</RestoreNoHttpCache>
  </PropertyGroup>

  <Import Project="../../SwarmUI.extension.props" />

  <!-- Copies the engine's private DLLs (and CUDA PTX kernels) into our output for the per-extension AssemblyLoadContext. -->
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Tests/ is its own project (own xunit/Test.Sdk references this Web SDK project doesn't carry) — without
       this, the SDK's default **/*.cs glob would also compile its sources into this assembly and fail. -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
  </ItemGroup>

  <!-- RELEASE: the published meta-package. https://www.nuget.org/packages/HartsyInference
       Pinned ahead of nuget.org's alpha.3 (its latest published version as of this writing): alpha.3
       predates the 2026-07-25 commit that made TextService.FindMmproj public, which this extension's
       HartsyLocalLLMProvider now calls. Pinned to alpha.4 in step with the other two SwarmUI-Hartsy
       extensions, ahead of the engine repo's manual publish of that version — restore will 404 until
       that push lands on nuget.org. NEVER pin a "-local" suffix here: this extension is cloned by
       end users who only have nuget.org, and a "-local" version only resolves on the dev feed at
       /home/hartsy/.local/share/hartsy-local-nuget.
       2.0.0-alpha.33 = the current nuget.org release, bringing this extension back in step with
       SwarmUI-HartsyInference-Backend and SwarmUI-AudioLab. It had drifted ten versions behind while the
       deployed output carried a hand-deployed local engine build, so the pin was not what actually ran.
       2.0.0-alpha.47 = threads the CPU kernels, which the voice path needs: token decode goes through the
       same GEMM that ran on a single core, and this extension shares a box with the TTS that dominates a
       voice turn. Note the pin had drifted to alpha.40 again while a gitignored Directory.Build.props
       pointed local builds at a checkout — a Release build against this pin is now verified.
       2.0.0-alpha.130 = catch-up bump, 2026-09-19 (alpha.47 -> alpha.130, 83 versions). Confirmed via a full
       Release build against this pin that nothing in this extension needed to change: compiled clean, no
       source edits, despite the size of the gap. Keeps this extension in lockstep with
       SwarmUI-HartsyInference-Backend and SwarmUI-AudioLab.
       2.0.0-alpha.235 = catch-up bump for the phone-call voice agent work, 2026-10-01 (alpha.130 -> alpha.235,
       105 versions). Nothing in that span changes a signature this extension calls — TextChunkKind/TextChunk
       and ChatMessage only gained new, additive members (Reasoning/ToolCallDelta/ToolCallAbort/Usage,
       ToolCallIndex/Status/Usage) — so this stays a clean build against the nuget.org package
       (UseLocalHartsy=false). Two source changes ride along in this same PR because they are tiny and
       directly enabled by this range: HartsyLocalLLMProvider.RoleFor now maps a Tool-role message onto
       TextRole.Tool with its id/name (alpha.220 added TextMessage.ToolCalls/ToolCallId/Name; nothing emitted
       a Tool-role LLMMessage before this, so this is a latent-bug fix, not a behavior change) and
       TextService.StreamAsync's lifetime fix (alpha.220, #193) is what LLMStreamHelper's mid-round
       roundCts.Cancel() (LLMStreamHelper.cs:96,110) already relied on being prompt — verified by the engine's
       own cancel-before-start / abandonment unit tests (<=100ms), not re-measured live here.
       2.0.0-alpha.237 = catch-up bump, 2026-10-01 (alpha.235 -> alpha.237, verified indexed on nuget.org for
       both hartsyinference.engine and hartsyinference.tools before bumping). alpha.236 (#215) fixes
       SamplerChain/TopPStep/TopKStep/MinPStep to reuse scratch buffers instead of argsorting the whole ~152K
       vocabulary through a Comparison<int> delegate every decode step on the non-greedy path (Greedy=false,
       this extension's default whenever Temperature > 0) — faster decode, token-identical output, no public
       signature touched. alpha.237 adds the new, separate HartsyInference.Voice package (the phone-call voice
       agent); this extension references neither it nor anything it depends on. Full Release build + full test
       run against this pin: clean, no source edits required by the bump itself (the source changes in this
       same PR are FIX 1/FIX 2/the messages-history and enableThinking additions, independent of the pin). -->
  <ItemGroup Condition="'$(UseLocalHartsy)' != 'true'">
    <PackageReference Include="HartsyInference" Version="2.0.0-alpha.237" />
    <!-- HartsyInference.Tools (ToolLoop/ToolRegistry/ToolCalling) is a separate package by design — it is
         NOT part of the HartsyInference meta package, so it needs its own reference. Published on nuget.org
         since alpha.222; pinned to the same alpha.237 as the meta package to stay in lockstep. -->
    <PackageReference Include="HartsyInference.Tools" Version="2.0.0-alpha.237" />
  </ItemGroup>

  <!-- LOCAL ENGINE DEBUGGING: prebuilt engine DLLs, not ProjectReferences (a ProjectReference would leak
       SwarmUI's global obj/output MSBuild properties into the engine projects and break their build).
       Build the engine first: dotnet build src/HartsyInference.{LLM,Cpu,Cuda}/*.csproj -c Release -f net8.0 -->
  <PropertyGroup Condition="'$(UseLocalHartsy)' == 'true'">
    <HartsyCfg Condition="'$(HartsyCfg)' == '' and Exists('$(HartsyRepo)/src/HartsyInference.LLM/bin/Release/net8.0/HartsyInference.LLM.dll')">Release</HartsyCfg>
    <HartsyCfg Condition="'$(HartsyCfg)' == ''">Debug</HartsyCfg>
    <HartsyEngineBin>$(HartsyRepo)/src/HartsyInference.Engine/bin/$(HartsyCfg)/net8.0</HartsyEngineBin>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalHartsy)' == 'true'">
    <!-- The extension now talks only to HartsyInference.Engine's ITextService — it no longer touches
         HartsyInference.LLM/ModelAssets/Cpu/Cuda types directly. This <Reference> was missing entirely
         from this ItemGroup before the Engine-delegation cutover (2026-07-25); Engine's own build output
         already carries its dependency closure (LLM/Core/ModelAssets/Cpu/Cuda), so those don't need
         separate entries here. -->
    <Reference Include="HartsyInference.Engine"><HintPath>$(HartsyEngineBin)/HartsyInference.Engine.dll</HintPath><Private>true</Private></Reference>
    <!-- Core carries the VRAM policy types (VramPolicy/VramTier) this backend maps its VramMode setting onto.
         Engine's output already ships Core at runtime; this entry is only so the compiler can see the types. -->
    <Reference Include="HartsyInference.Core"><HintPath>$(HartsyEngineBin)/HartsyInference.Core.dll</HintPath><Private>true</Private></Reference>
    <!-- HartsyInference.Tools lives in its own project, not Engine's output closure (it depends ON Engine,
         not the reverse), so it needs its own local-dev path: dotnet build src/HartsyInference.Tools -c
         $(HartsyCfg) -f net8.0 -->
    <Reference Include="HartsyInference.Tools"><HintPath>$(HartsyRepo)/src/HartsyInference.Tools/bin/$(HartsyCfg)/net8.0/HartsyInference.Tools.dll</HintPath><Private>true</Private></Reference>
    <Content Include="$(HartsyRepo)/src/HartsyInference.Cuda/Ptx/*.ptx" Link="Ptx/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Loud reminder that a local-engine build is NOT what end users get: they build against the
       NuGet pin above. Before any release, prove that path compiles: dotnet build -p:UseLocalHartsy=false -->
  <Target Name="WarnLocalHartsy" BeforeTargets="Build" Condition="'$(UseLocalHartsy)' == 'true'">
    <Warning Text="Building against the LOCAL HartsyInference engine (Directory.Build.props). Release builds must use the NuGet pin: dotnet build -p:UseLocalHartsy=false" />
  </Target>

  <!-- Compile against the packages the SwarmUI host already loads, without copying their runtime DLLs.
       Keep in sync with SwarmUI.deps.props. -->
  <ItemGroup>
    <PackageReference Update="FreneticLLC.FreneticUtilities" ExcludeAssets="runtime" />
    <PackageReference Update="Hardware.Info" ExcludeAssets="runtime" />
    <PackageReference Update="LiteDB" ExcludeAssets="runtime" />
    <PackageReference Update="LLamaSharp" ExcludeAssets="runtime" />
    <PackageReference Update="LLamaSharp.Backend.Cpu" ExcludeAssets="runtime" />
    <PackageReference Update="LLamaSharp.Backend.Cuda12" ExcludeAssets="runtime" />
    <PackageReference Update="Newtonsoft.Json" ExcludeAssets="runtime" />
    <PackageReference Update="SixLabors.ImageSharp" ExcludeAssets="runtime" />
    <PackageReference Update="SixLabors.ImageSharp.Drawing" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
